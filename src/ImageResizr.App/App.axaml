<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="ImageResizr.App.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#FF914D" />
        <SolidColorBrush x:Key="ButtonSolidPrimaryBorderBrush" Color="#FF914D" />
        <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBackground" Color="#F57F38" />
        <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBorderBrush" Color="#F57F38" />
        <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBackground" Color="#E66F28" />
        <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBorderBrush" Color="#E66F28" />

        <SolidColorBrush x:Key="CheckBoxCheckedDefaultBackground" Color="#FF914D" />
        <SolidColorBrush x:Key="CheckBoxCheckedDefaultBorderBrush" Color="#FF914D" />
        <SolidColorBrush x:Key="CheckBoxCheckedDisabledBackground" Color="#FFD8BF" />
        <SolidColorBrush x:Key="CheckBoxCheckedDisabledBorderBrush" Color="#FFD8BF" />
        <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBackground" Color="#F57F38" />
        <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBorderBrush" Color="#F57F38" />
        <SolidColorBrush x:Key="CheckBoxCheckedPressedBackground" Color="#E66F28" />
        <SolidColorBrush x:Key="CheckBoxCheckedPressedBorderBrush" Color="#E66F28" />
        <SolidColorBrush x:Key="CheckBoxPointeroverBorderBrush" Color="#F57F38" />
        <SolidColorBrush x:Key="CheckBoxPressedBorderBrush" Color="#E66F28" />
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="en-US" />

        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="#FF914D" />
            <Setter Property="BorderBrush" Value="#FF914D" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.Primary:pointerover">
            <Setter Property="Background" Value="#F57F38" />
            <Setter Property="BorderBrush" Value="#F57F38" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.Primary:pressed">
            <Setter Property="Background" Value="#E66F28" />
            <Setter Property="BorderBrush" Value="#E66F28" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="Border.info">
            <Setter Property="Background" Value="#FFF0E8" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="Border.validation">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="Border.tag">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style Selector="TextBlock.heading-large">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <Style Selector="TextBlock.heading-medium">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <Style Selector="TextBlock.body-text">
            <Setter Property="Foreground" Value="#475569" />
        </Style>

        <Style Selector="TextBlock.accent">
            <Setter Property="Foreground" Value="#FF914D" />
        </Style>
    </Application.Styles>
</Application>
