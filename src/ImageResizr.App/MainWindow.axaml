<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localization="using:ImageResizr.App.Localization"
        xmlns:viewModels="using:ImageResizr.App.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="1120"
        d:DesignHeight="820"
        x:Class="ImageResizr.App.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Width="1120"
        Height="800"
        MinWidth="1120"
        MinHeight="800"
        Background="{DynamicResource AppPageBackgroundBrush}"
        CanResize="True"
        Icon="/Assets/AppIcon.ico"
        Title="{x:Static localization:Strings.Window_Title}">

    <Grid ColumnDefinitions="1.25*,0.95*"
          ColumnSpacing="24"
          Margin="14">
        <Border Classes="card">
            <Grid RowDefinitions="*,Auto" RowSpacing="18">
                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="0,0,6,0">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="heading-large"
                                       Text="{x:Static localization:Strings.Main_Title}" />
                            <TextBlock Classes="body-text"
                                       Text="{x:Static localization:Strings.Main_Description}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Classes="section-title"
                                       Text="{x:Static localization:Strings.SourceFolder_Label}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0"
                                         MinHeight="42"
                                         IsReadOnly="True"
                                         Text="{Binding InputFolder}"
                                         PlaceholderText="{x:Static localization:Strings.SourceFolder_Watermark}" />
                                <Button Grid.Column="1"
                                        Width="50"
                                        Command="{Binding PickInputFolderCommand}"
                                        IsEnabled="{Binding CanEditInputs}"
                                        ToolTip.Tip="{x:Static localization:Strings.Browse_ToolTip}"
                                        Classes="Primary"
                                        Theme="{StaticResource SolidButton}">
                                    <PathIcon Width="18" Height="18" Data="M3 6H9L11 8H21V19H3Z" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Classes="section-title"
                                       Text="{x:Static localization:Strings.TargetFolder_Label}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0"
                                         MinHeight="42"
                                         IsReadOnly="True"
                                         Text="{Binding OutputFolder}"
                                         PlaceholderText="{x:Static localization:Strings.TargetFolder_Watermark}" />
                                <Button Grid.Column="1"
                                        Width="50"
                                        Command="{Binding PickOutputFolderCommand}"
                                        IsEnabled="{Binding CanEditInputs}"
                                        ToolTip.Tip="{x:Static localization:Strings.Browse_ToolTip}"
                                        Classes="Primary"
                                        Theme="{StaticResource SolidButton}">
                                    <PathIcon Width="18" Height="18" Data="M3 6H9L11 8H21V19H3Z" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <TextBlock Classes="heading-medium"
                                   FontSize="18"
                                   Margin="0,2,0,-4"
                                   Text="{x:Static localization:Strings.ResizeOptions_Title}" />

                        <StackPanel Spacing="8">
                            <TextBlock Classes="section-title"
                                       Text="{x:Static localization:Strings.SizePreset_Label}" />
                            <ComboBox ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      IsEnabled="{Binding CanEditInputs}"
                                      MinHeight="48"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:ResizePresetItemViewModel">
                                        <Border Padding="0,4">
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <TextBlock Classes="muted-text"
                                                           FontSize="12"
                                                           Text="{Binding Description}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*,96" ColumnSpacing="12">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section-title"
                                           Text="{x:Static localization:Strings.Width_Label}" />
                                <NumericUpDown ClipValueToMinMax="True"
                                               ParsingNumberStyle="Integer"
                                               FormatString="N0"
                                               Value="{Binding TargetWidth}"
                                               Increment="10"
                                               Minimum="1"
                                               Maximum="10000"
                                               IsEnabled="{Binding CanEditCustomDimensions}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Classes="section-title"
                                           Text="{x:Static localization:Strings.Height_Label}" />
                                <NumericUpDown ClipValueToMinMax="True"
                                               ParsingNumberStyle="Integer"
                                               FormatString="N0"
                                               Value="{Binding TargetHeight}"
                                               Increment="10"
                                               Minimum="1"
                                               Maximum="10000"
                                               IsEnabled="{Binding CanEditCustomDimensions}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="8">
                                <TextBlock Classes="section-title"
                                           Text="{x:Static localization:Strings.Unit_Label}" />
                                <Border Classes="panel" Padding="10,8">
                                    <TextBlock HorizontalAlignment="Center"
                                               Classes="body-text"
                                               Text="{x:Static localization:Strings.Pixels_Label}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock Classes="section-title"
                                       Text="{x:Static localization:Strings.ResizeMode_Label}" />
                            <ComboBox ItemsSource="{Binding ResizeModes}"
                                      SelectedItem="{Binding SelectedResizeMode}"
                                      IsEnabled="{Binding CanEditInputs}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:ResizeModeItemViewModel">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Border Classes="panel">
                            <StackPanel Spacing="10">
                                <CheckBox Content="{x:Static localization:Strings.ShrinkOnly_Label}"
                                          IsEnabled="{Binding CanEditInputs}"
                                          IsChecked="{Binding ShrinkOnly}" />
                                <CheckBox Content="{x:Static localization:Strings.IgnoreOrientation_Label}"
                                          IsEnabled="{Binding CanEditInputs}"
                                          IsChecked="{Binding IgnoreOrientation}" />
                                <CheckBox Content="{x:Static localization:Strings.OverwriteFiles_Label}"
                                          IsEnabled="{Binding CanEditInputs}"
                                          IsChecked="{Binding OverwriteExisting}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="validation" IsVisible="{Binding HasValidationMessage}">
                            <TextBlock Foreground="{DynamicResource AppValidationTextBrush}"
                                       Text="{Binding ValidationMessage}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="1"
                        Classes="Primary"
                        Theme="{StaticResource SolidButton}"
                        Command="{Binding StartCommand}"
                        Content="{Binding StartButtonText}"
                        HorizontalAlignment="Stretch" />
            </Grid>
        </Border>

        <Border Grid.Column="1" Classes="card">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock Classes="heading-medium"
                               Text="{x:Static localization:Strings.Progress_Title}" />
                    <TextBlock Classes="body-text"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="1" Classes="progress-panel">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section-title"
                                   Text="{x:Static localization:Strings.Progress_OverallTitle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Classes="accent"
                                       FontWeight="SemiBold"
                                       Text="{Binding ProgressSummary}" />
                            <TextBlock Grid.Column="1"
                                       Classes="accent"
                                       FontWeight="SemiBold"
                                       Text="{Binding ProgressPercentageText}" />
                        </Grid>
                        <ProgressBar Height="12"
                                     Foreground="{DynamicResource AppAccentBrush}"
                                     Maximum="{Binding ProgressBarMaximum}"
                                     Value="{Binding ProgressValue}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8" MinHeight="0">
                    <TextBlock Grid.Row="0"
                               Classes="section-title"
                               Text="{x:Static localization:Strings.Progress_HistoryTitle}" />

                    <Grid Grid.Row="1" MinHeight="0">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="20"
                                   Classes="muted-text"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !HasHistory}"
                                   Text="{x:Static localization:Strings.Progress_NoFiles}" />

                        <ListBox x:Name="HistoryList"
                                 Classes="history-list"
                                 ItemsSource="{Binding ResizeHistory}"
                                 IsVisible="{Binding HasHistory}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ResizeHistoryItemViewModel">
                                    <Border Classes="history-row">
                                        <Grid ColumnDefinitions="22,*,Auto"
                                              RowDefinitions="Auto,Auto"
                                              ColumnSpacing="6">
                                            <TextBlock Grid.RowSpan="2"
                                                       Classes="accent"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Text="{Binding StatusSymbol}" />
                                            <TextBlock Grid.Column="1"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       Text="{Binding FileName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Classes="muted-text"
                                                       FontSize="12"
                                                       Text="{Binding StatusText}" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Grid.ColumnSpan="2"
                                                       Margin="0,2,0,0"
                                                       Classes="body-text"
                                                       FontSize="12"
                                                       Text="{Binding DetailText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
