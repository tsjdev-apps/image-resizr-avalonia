<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="using:ImageResizr.App.ViewModels"
        xmlns:models="using:ImageResizr.Core.Models"
        xmlns:converters="using:ImageResizr.App.Converters"
        mc:Ignorable="d"
        d:DesignWidth="960"
        d:DesignHeight="620"
        x:Class="ImageResizr.App.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Width="960"
        Height="700"
        MinWidth="960"
        MinHeight="700"
        Background="#F5F7FA"
        CanResize="False"
        Icon="/Assets/AppIcon.ico"
        Title="ImageResizr by tsjdev-apps">

    <Window.Resources>
        <converters:ProgressLevelToBrushConverter x:Key="ProgressLevelToBrushConverter" />
    </Window.Resources>

    <Grid ColumnDefinitions="1.4*,0.9*"
          ColumnSpacing="24"
          Margin="12">
        <Border Classes="card">
            <StackPanel Spacing="18">
                <StackPanel Spacing="4">
                    <TextBlock Classes="heading-large" Text="Batch setup" />
                    <TextBlock Classes="body-text"
                               Text="Choose folders, select a size, and decide how the batch should handle image details."
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Foreground="#1E293B" Text="Input folder" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0"
                                 IsReadOnly="True"
                                 Text="{Binding InputFolder}"
                                 PlaceholderText="Select the folder that contains your source images" />
                        <Button Grid.Column="1"
                                Command="{Binding PickInputFolderCommand}"
                                IsEnabled="{Binding CanEditInputs}"
                                MinWidth="50"
                                ToolTip.Tip="Browse..."
                                Classes="Primary"
                                Theme="{StaticResource SolidButton}">
                            <PathIcon Width="18" Height="18" Data="M3 6H9L11 8H21V19H3Z" />
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Foreground="#1E293B" Text="Output folder" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0"
                                 IsReadOnly="True"
                                 Text="{Binding OutputFolder}"
                                 PlaceholderText="Select where resized images should be written" />
                        <Button Grid.Column="1"
                                Command="{Binding PickOutputFolderCommand}"
                                IsEnabled="{Binding CanEditInputs}"
                                MinWidth="50"
                                ToolTip.Tip="Browse..."
                                Classes="Primary"
                                Theme="{StaticResource SolidButton}">
                            <PathIcon Width="18" Height="18" Data="M3 6H9L11 8H21V19H3Z" />
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Foreground="#1E293B" Text="Size preset" />
                    <ComboBox ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset}"
                              IsEnabled="{Binding CanEditInputs}"
                              MinHeight="48"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ResizePresetOption">
                                <Border Padding="0,4">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                        <TextBlock FontSize="12" Foreground="#475569" Text="{Binding Description}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Grid ColumnDefinitions="*,*,110" ColumnSpacing="12">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Foreground="#1E293B" Text="Width" />
                        <NumericUpDown ClipValueToMinMax="True"
                                       ParsingNumberStyle="Integer"
                                       FormatString="N0"
                                       Value="{Binding TargetWidth}"
                                       Increment="10"
                                       Minimum="1"
                                       Maximum="10000"
                                       IsEnabled="{Binding CanEditCustomDimensions}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock FontWeight="SemiBold" Foreground="#1E293B" Text="Height" />
                        <NumericUpDown ClipValueToMinMax="True"
                                       ParsingNumberStyle="Integer"
                                       FormatString="N0"
                                       Value="{Binding TargetHeight}"
                                       Increment="10"
                                       Minimum="1"
                                       Maximum="10000"
                                       IsEnabled="{Binding CanEditCustomDimensions}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="8">
                        <TextBlock FontWeight="SemiBold" Foreground="#1E293B" Text="Unit" />
                        <Border Classes="panel" Padding="12,8">
                            <TextBlock HorizontalAlignment="Center" Foreground="#475569" Text="Pixels" />
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Foreground="#1E293B" Text="Resize mode" />
                    <ComboBox ItemsSource="{Binding ResizeModes}"
                              SelectedItem="{Binding SelectedResizeMode}"
                              IsEnabled="{Binding CanEditInputs}"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <Border Classes="panel">
                    <StackPanel Spacing="10">
                        <CheckBox Content="Make pictures smaller but not larger"
                                  IsEnabled="{Binding CanEditInputs}"
                                  IsChecked="{Binding ShrinkOnly}" />
                        <CheckBox Content="Ignore the orientation of pictures"
                                  IsEnabled="{Binding CanEditInputs}"
                                  IsChecked="{Binding IgnoreOrientation}" />
                        <CheckBox Content="Overwrite files"
                                  IsEnabled="{Binding CanEditInputs}"
                                  IsChecked="{Binding OverwriteExisting}" />
                    </StackPanel>
                </Border>

                <Border Classes="validation" IsVisible="{Binding HasValidationMessage}">
                    <TextBlock Foreground="#B91C1C" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
                </Border>

                <Button Classes="Primary"
                        Theme="{StaticResource SolidButton}"
                        Command="{Binding StartCommand}"
                        Content="{Binding StartButtonText}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*,Auto"
              RowSpacing="24">
            <Border Grid.Row="0" Classes="card">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="heading-medium" Text="Live progress" />
                        <TextBlock Classes="body-text" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Classes="info">
                        <StackPanel Spacing="12">
                            <TextBlock FontWeight="SemiBold" Classes="accent" Text="{Binding ProgressSummary}" />
                            <ProgressBar Height="12"
                                         Foreground="#FF914D"
                                         Maximum="{Binding ProgressMaximum}"
                                         Value="{Binding ProgressValue}" />
                            <TextBlock Foreground="#FF914D" Text="{Binding ProgressPercentageText}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="panel">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Foreground="#0F172A" Text="Latest activity" />
                            <TextBlock Text="{Binding LatestActivityMessage}"
                                       MinHeight="44"
                                       MaxHeight="44"
                                       MaxLines="2"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding LatestActivityLevel, Converter={StaticResource ProgressLevelToBrushConverter}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="heading-medium" Text="Supported formats" />
                    <WrapPanel>
                        <Border Classes="tag"><TextBlock Text=".jpg" /></Border>
                        <Border Classes="tag"><TextBlock Text=".jpeg" /></Border>
                        <Border Classes="tag"><TextBlock Text=".png" /></Border>
                        <Border Classes="tag"><TextBlock Text=".gif" /></Border>
                        <Border Classes="tag"><TextBlock Text=".bmp" /></Border>
                        <Border Classes="tag"><TextBlock Text=".webp" /></Border>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
